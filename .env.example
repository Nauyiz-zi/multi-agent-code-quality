# Copy this file to .env and choose ONE provider configuration.

# Option 1: DeepSeek
DEEPSEEK_API_KEY=

# Option 2: Alibaba Cloud DashScope / Qwen
DASHSCOPE_API_KEY=

# Option 3: OpenAI or any OpenAI-compatible service
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Option 4: Generic configuration
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
